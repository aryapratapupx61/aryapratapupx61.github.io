b81ff\"><div class=\"gb-container gb-container-fcbb81ff\">\n\n<h4 class=\"gb-headline gb-headline-4ddaf9ee gb-headline-text\"><strong>Application Fee</strong></h4>\n\n\n<div class=\"gb-headline gb-headline-989f3ffd gb-headline-text\"><ul>\n<li><span style=\"font-size:14.6px\">For<strong> General, OBC, EWS </strong>: <strong>₹ 2000/-</strong></span></li>\n<li><span style=\"font-size:14.6px\">For<strong> SC / ST, PwD</strong> : <strong>₹ 500/-</strong></span></li>\n</ul>\n<ul>\n<li><span style=\"font-size:14.6px\"><strong>Payment Mode (Online):</strong> You can make the payment using the following methods:</span>\n<ul>\n<li><span style=\"font-size:14.6px\">Debit Card</span></li>\n<li><span style=\"font-size:14.6px\">Credit Card</span></li>\n<li><span style=\"font-size:14.6px\">Internet Banking</span></li>\n<li><span style=\"font-size:14.6px\">IMPS</span></li>\n<li><span style=\"font-size:14.6px\">Cash Card / Mobile Wallet</span></li>\n</ul>\n</li>\n</ul>\n</div>\n</div></div>\n</div>\n</div>\n\n<div class=\"gb-container gb-container-6b6fbcac\">\n<div class=\"gb-grid-wrapper gb-grid-wrapper-8aa46b64\">\n<div class=\"gb-grid-column gb-grid-column-0f18d865\"><div class=\"gb-container gb-container-0f18d865\">\n<h5 class=\"gb-headline gb-headline-0b3ada47 gb-headline-text\">High Court of Delhi Notification 2026 : Age Limits As On 15 July 2026</h5>\n\n<div class=\"gb-headline gb-headline-28dede61 gb-headline-text\"><ul>\n<li><span style=\"font-size:14.6px\">Minimum Age : <strong>35 Years </strong></span></li>\n<li><span style=\"font-size:14.6px\">Maximum Age : <strong>45 Years </strong></span></li>\n<li><span style=\"font-size:14.6px\"><strong>High Court of Delhi</strong> provides age relaxation for the <strong>Delhi Higher Judicial Service (HJS) </strong>position as per their regulations.</span></li>\n</ul>\n</div>\n</div></div>\n\n<div class=\"gb-grid-column gb-grid-column-860b2712\"><div class=\"gb-container gb-container-860b2712\">\n\n<h5 class=\"gb-headline gb-headline